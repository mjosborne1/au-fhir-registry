     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: NamingSystem MedicareProviderNumber</b></p><a name=\"MedicareProviderNumber\"> </a><a name=\"hcMedicareProviderNumber\"> </a><h3>Summary</h3><table class=\"grid\"><tr><td>Defining URL</td><td>http://ns.electronichealth.net.au/fhir/NamingSystem/medicareprovidernum</td></tr><tr><td>Version</td><td>0.1.0</td></tr><tr><td>Name</td><td>MedicareProviderNumber</td></tr><tr><td>Status</td><td>draft</td></tr><tr><td>Definition</td><td><div><p>Medicare Provider Number. A Medicare provider number is assigned by Services Australia under the Medicare program to practitioners who provide services that are eligible for a Medicare benefit. A practitioner may have more than one Medicare provider number if they deliver health services in different locations or are registered in multiple health professions.</p>\n</div></td></tr><tr><td>Publisher</td><td>HL7 AU Publisher</td></tr></table><h3>Identifiers</h3><table class=\"grid\"><tr><td><b>Type</b></td><td><b>Value</b></td><td><b>Preferred</b></td><td><b>Comment</b></td></tr><tr><td>URI</td><td>http://ns.electronichealth.net.au/id/medicare-provider-number</td><td>true</td><td>This value is used for Australian FHIR Implementations.</td></tr><tr><td>OID</td><td>1.2.36.174030967.0.2</td><td/><td>This value is used in Australian CDA documents and OID based systems.</td></tr></table></div>"^^rdf:XMLLiteral ]
