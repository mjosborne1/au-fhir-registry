         fhir:reference [ fhir:v "NamingSystem/AUNATAAccreditationNumber" ]
       ] ;
       fhir:name [ fhir:v "Australian National Association of Testing Authorities (NATA) Accreditation Number" ] ;
       fhir:description [ fhir:v "National Association of Testing Authorities (NATA) Accreditation Number is used to identify approved testing laboratories in the Australian context." ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v false
       ]
     ] [
       fhir:extension ( [
