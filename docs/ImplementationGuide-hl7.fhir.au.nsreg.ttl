         ] ;
         fhir:value [
           a fhir:String ;
           fhir:v "NamingSystem"
         ]
       ] ) ;
       fhir:reference [
         fhir:l <http://hl7.org.au/fhir/nsreg/NamingSystem/PharmacyApprovalNumber> ;
         fhir:reference [ fhir:v "NamingSystem/PharmacyApprovalNumber" ]
       ] ;
       fhir:name [ fhir:v "Pharmacy Approval Number" ] ;
       fhir:description [ fhir:v "Pharmacy Approval Number. A pharmacy approval number, also known as a PBS approval number, is assigned by the Department of Health to pharmacies that are approved to supply pharmaceutical benefits at particular premises under the National Health Act 1953." ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v false
       ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
