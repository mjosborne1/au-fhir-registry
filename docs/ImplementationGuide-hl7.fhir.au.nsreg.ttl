         ] ;
         fhir:value [
           a fhir:String ;
           fhir:v "NamingSystem"
         ]
       ] ) ;
       fhir:reference [
         fhir:l <http://hl7.org.au/fhir/nsreg/NamingSystem/MedicareNumber> ;
         fhir:reference [ fhir:v "NamingSystem/MedicareNumber" ]
       ] ;
       fhir:name [ fhir:v "Medicare Number" ] ;
       fhir:description [ fhir:v "Medicare Card Number. A Medicare card is provided to individuals who are enrolled in Medicare. This identifier system may be used for the 10 digit Medicare card number or the 11 digit number that includes the individual reference number (IRN)." ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v false
       ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/tools/StructureDefinition/resource-information>
         ] ;
         fhir:value [
           a fhir:String ;
           fhir:v "NamingSystem"
         ]
       ] ) ;
       fhir:reference [
         fhir:l <http://hl7.org.au/fhir/nsreg/NamingSystem/MedicareProviderNumber> ;
         fhir:reference [ fhir:v "NamingSystem/MedicareProviderNumber" ]
       ] ;
       fhir:name [ fhir:v "Medicare Provider Number" ] ;
       fhir:description [ fhir:v "Medicare Provider Number. A Medicare provider number is assigned by Services Australia under the Medicare program to practitioners who provide services that are eligible for a Medicare benefit. A practitioner may have more than one Medicare provider number if they deliver health services in different locations or are registered in multiple health professions." ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v false
       ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/tools/StructureDefinition/resource-information>
         ] ;
         fhir:value [
           a fhir:String ;
           fhir:v "NamingSystem"
         ]
       ] ) ;
       fhir:reference [
         fhir:l <http://hl7.org.au/fhir/nsreg/NamingSystem/PBSPrescriberNumber> ;
         fhir:reference [ fhir:v "NamingSystem/PBSPrescriberNumber" ]
       ] ;
       fhir:name [ fhir:v "Pharmaceutical Benefits Scheme (PBS) prescriber number" ] ;
       fhir:description [ fhir:v "Pharmaceutical Benefits Scheme (PBS) prescriber number. A PBS prescriber number is assigned by Services Australia under the Pharmaceutical Benefits Scheme to practitioners who are approved to prescribe PBS medicines under the National Health Act 1953." ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v false
       ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
