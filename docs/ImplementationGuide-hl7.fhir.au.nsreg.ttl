       ] ;
       fhir:name [ fhir:v "AU Care Agency Employee Identifier" ] ;
       fhir:description [ fhir:v "A CAE identifier may be issued to an employee of, or person under contracted arrangement with, a care agency who wishes to participate in the My Health Record." ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v false
       ]
