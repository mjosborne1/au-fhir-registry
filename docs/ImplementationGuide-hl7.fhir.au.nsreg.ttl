         fhir:reference [ fhir:v "NamingSystem/CSPRegistrationNumber" ]
       ] ;
       fhir:name [ fhir:v "AU Contracted Service Provider Registration Number" ] ;
       fhir:description [ fhir:v "A CSP registration number may be issued to organisations who wish to participate in the My Health Record and/or the Healthcare Identifiers Service as a CSP." ] ;
