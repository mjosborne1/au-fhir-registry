       fhir:name [ fhir:v "Australian Healthcare Provider Identifier - Organisation (HPI-O)" ] ;
       fhir:description [ fhir:v "This namespace is used to represent Healthcare Provider Identifier for Organisations (HPI-O) numbers." ] ;
       fhir:example [
         a fhir:Boolean ;
