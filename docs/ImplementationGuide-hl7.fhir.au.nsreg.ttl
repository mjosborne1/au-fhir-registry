       fhir:name [ fhir:v "Australian Department of Veterans’ Affairs (DVA) file number" ] ;
       fhir:description [ fhir:v "Australian Department of Veterans’ Affairs (DVA) file number. An individual’s state-based Department of Veterans’ Affairs (DVA) File number as displayed on a Veteran Card." ] ;
