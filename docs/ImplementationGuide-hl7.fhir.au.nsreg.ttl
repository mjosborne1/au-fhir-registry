         fhir:reference [ fhir:v "NamingSystem/IHI" ]
       ] ;
       fhir:name [ fhir:v "Australian Individual Healthcare Identifier (IHI)" ] ;
       fhir:description [ fhir:v "Australian Individual Healthcare Identifier (IHI). An IHI is assigned under the Healthcare Identifiers (HI) Service to a patient." ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v false
       ]
     ] [
