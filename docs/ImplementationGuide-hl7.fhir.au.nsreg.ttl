         ] ;
         fhir:value [
           a fhir:String ;
           fhir:v "NamingSystem"
         ]
       ] ) ;
       fhir:reference [
         fhir:l <http://hl7.org.au/fhir/nsreg/NamingSystem/LSPN> ;
         fhir:reference [ fhir:v "NamingSystem/LSPN" ]
       ] ;
       fhir:name [ fhir:v "Location Specific Practice Number" ] ;
       fhir:description [ fhir:v "Location Specific Practice Number. A Location Specific Practice Number (LSPN) is an identifier assigned to a specific location by Services Australia under the Medicare program and identifies an accredited practice site that provides diagnostic imaging and radiation oncology services." ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v false
       ]
     ] [
       fhir:extension ( [
         fhir:url [
