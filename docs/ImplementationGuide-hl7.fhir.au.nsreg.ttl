       ] ;
       fhir:name [ fhir:v "Australian Business Number (ABN)" ] ;
       fhir:description [ fhir:v "Australian Business Number (ABN) is a unique 11 digit number that identifies a business or organisation in Australia. ABN lookup is available here https://abr.business.gov.au/." ] ;
