       ] ;
       fhir:name [ fhir:v "Residential Aged Care Service Identifier" ] ;
       fhir:description [ fhir:v "Residential Aged Care Service identifier. A RACS ID (also referred to as a residential aged care facility service identifier (RACF ID)) is assigned by DOHAC to a subsidised residential aged care service." ] ;
