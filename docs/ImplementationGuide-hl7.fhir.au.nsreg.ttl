       ] ;
       fhir:name [ fhir:v "Australian Healthcare Provider Identifier - Individual (HPI-I)" ] ;
       fhir:description [ fhir:v "This namespace is used to represent Healthcare Provider Identifier for Individuals (HPI-I) numbers." ] ;
