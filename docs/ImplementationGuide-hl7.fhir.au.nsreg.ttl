         fhir:reference [ fhir:v "NamingSystem/NPIO" ]
       ] ;
       fhir:name [ fhir:v "Australian National Provider Identifier at an Organisation (NPIO)" ] ;
       fhir:description [ fhir:v "A National Provider Identifier at Organisation (NPIO) uniquely identifies an individual practitioner at an organisation using the practitioner’s HPI-I and organisation’s HPI-O to form the NPIO." ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v false
       ]
     ] [
