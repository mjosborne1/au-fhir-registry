       ] ;
       fhir:name [ fhir:v "Australian National Association of Testing Authorities (NATA) Site Number" ] ;
       fhir:description [ fhir:v "National Association of Testing Authorities (NATA) Accreditation Number is used to identify approved testing laboratory locations in the Australian context." ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v false
       ]
     ] [
       fhir:extension ( [
