         fhir:reference [ fhir:v "NamingSystem/AHPRANumber" ]
       ] ;
       fhir:name [ fhir:v "Australian Health Practitioner Regulation Agency (AHPRA) Registration Number" ] ;
       fhir:description [ fhir:v "An Australian Health Practitioner Regulation Authority (AHPRA) registration number assigned to a practitioner for each profession in which they are registered. Practitioners registered in more than one profession have one registration number for each profession." ] ;
